rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(tenantId) {
      return signedIn() &&
        firestore.exists(
          /databases/(default)/documents/tenants/$(tenantId)/users/$(request.auth.uid)
        );
    }

    match /tenants/{tenantId}/animales/{fileName} {
      allow read, write: if isMember(tenantId);
    }

    match /tenants/{tenantId}/perfiles/{fileName} {
      allow read: if isMember(tenantId);
      allow write: if isMember(tenantId) &&
        fileName == request.auth.uid + '.jpg';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
